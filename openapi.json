{
  "openapi": "3.0.3",
  "info": {
    "title": "API CUP Simulacro",
    "description": "Documentación automática de la API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/questions": {
      "get": {
        "summary": "Preguntas para práctica o caché offline",
        "tags": [
          "questions"
        ],
        "description": "Devuelve preguntas verificadas. Nunca incluye la respuesta correcta (`correct_key`).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "faculty",
            "required": false,
            "description": "Código de la facultad (ej: \"ficct\")."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "subject",
            "required": false,
            "description": "Código de la materia (ej: \"matematicas\")."
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "count",
            "required": false,
            "description": "Cantidad de preguntas a devolver (selección aleatoria)."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "exclude",
            "required": false,
            "description": "IDs de preguntas a excluir, separados por coma."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Identificador legible (ej: \"mat-001\")."
                          },
                          "facultyId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "subjectId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "topic": {
                            "type": "string"
                          },
                          "statementMd": {
                            "type": "string",
                            "description": "Enunciado en Markdown."
                          },
                          "imageUrl": {
                            "nullable": true,
                            "type": "string"
                          },
                          "options": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "key": {
                                  "type": "string",
                                  "description": "Clave de la opción (ej: \"A\")."
                                },
                                "text": {
                                  "type": "string",
                                  "description": "Texto visible de la opción."
                                }
                              },
                              "required": [
                                "key",
                                "text"
                              ],
                              "additionalProperties": {}
                            }
                          },
                          "explanationMd": {
                            "nullable": true,
                            "type": "string"
                          },
                          "procedureMd": {
                            "nullable": true,
                            "type": "string"
                          },
                          "videoUrl": {
                            "nullable": true,
                            "type": "string"
                          },
                          "difficulty": {
                            "nullable": true,
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "draft",
                              "verified",
                              "flagged"
                            ]
                          },
                          "sourceRef": {
                            "nullable": true,
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "facultyId",
                          "subjectId",
                          "topic",
                          "statementMd",
                          "imageUrl",
                          "options",
                          "explanationMd",
                          "procedureMd",
                          "videoUrl",
                          "difficulty",
                          "status",
                          "sourceRef"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/attempts/submit": {
      "post": {
        "summary": "Envía respuestas del simulacro y calcula el puntaje en el servidor",
        "tags": [
          "attempts"
        ],
        "description": "Cruza las respuestas contra `correct_key` en Postgres, guarda el intento y devuelve el desglose total, por materia y por pregunta.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Mapa questionId -> opción marcada (ej: {\"mat-001\": \"B\"})."
                  },
                  "questionIds": {
                    "description": "Lista completa de IDs de preguntas del examen (incluidas las no respondidas).",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "startTime": {
                    "description": "Timestamp (ms) o fecha ISO de inicio del intento.",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "endTime": {
                    "description": "Timestamp (ms) o fecha ISO de finalización del intento.",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "answers"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "attemptId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "userId": {
                          "nullable": true,
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "in_progress",
                            "completed"
                          ]
                        },
                        "score": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "totalQuestions": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "answeredCount": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "unansweredCount": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "percentage": {
                          "type": "number"
                        },
                        "startTime": {
                          "type": "string"
                        },
                        "endTime": {
                          "type": "string"
                        },
                        "bySubject": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subjectId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                              },
                              "subjectCode": {
                                "type": "string"
                              },
                              "subjectName": {
                                "type": "string"
                              },
                              "total": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "correct": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              "percentage": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "subjectId",
                              "subjectCode",
                              "subjectName",
                              "total",
                              "correct",
                              "percentage"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "questionId": {
                                "type": "string"
                              },
                              "subjectId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                              },
                              "subjectCode": {
                                "type": "string"
                              },
                              "subjectName": {
                                "type": "string"
                              },
                              "selectedKey": {
                                "nullable": true,
                                "type": "string"
                              },
                              "correctKey": {
                                "type": "string"
                              },
                              "isCorrect": {
                                "type": "boolean"
                              },
                              "explanationMd": {
                                "nullable": true,
                                "type": "string"
                              },
                              "procedureMd": {
                                "nullable": true,
                                "type": "string"
                              },
                              "videoUrl": {
                                "nullable": true,
                                "type": "string"
                              }
                            },
                            "required": [
                              "questionId",
                              "subjectId",
                              "subjectCode",
                              "subjectName",
                              "selectedKey",
                              "correctKey",
                              "isCorrect",
                              "explanationMd",
                              "procedureMd",
                              "videoUrl"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "attemptId",
                        "userId",
                        "status",
                        "score",
                        "totalQuestions",
                        "answeredCount",
                        "unansweredCount",
                        "percentage",
                        "startTime",
                        "endTime",
                        "bySubject",
                        "results"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
